[node name="Body" type="Label" parent="HowToPanel/V"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "WASD 이동 · Shift 달리기 · 마우스 조준 · 좌클릭 물 뿌리기
1~5 / 마우스 휠 무기 교체 · Tab 꾹 무기 휠
우클릭 카메라 (학생 비행, 무단횡단, 음주운전 신고)
E 줍기 / 대화 / 소화전 물 채우기 · F 차 타기 · V 3인칭
B 장비실 · Esc 일시정지

근무는 10시부터 새벽 2시까지. 할당량을 채우고 파출소 근무 일지에서 퇴근!
단속하면 구역이 깨끗해지고 조직 단서가 나와요. 단서 5개면 아지트 급습!"
horizontal_alignment = 1

